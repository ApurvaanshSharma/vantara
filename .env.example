# Copy this file to .env and fill in real values.
# .env.example is committed to git (no secrets here).
# .env is gitignored — never commit it.

# --- Postgres ---
POSTGRES_USER=vantara
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=vantara

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200
# Must be 8+ chars with upper, lower, digit, and special char (OpenSearch demo installer enforces this)
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Vantara@Dev2026!

# --- Backend / JWT ---
# Generate a real one with: openssl rand -hex 32
# Never reuse this placeholder value outside your own local machine.
JWT_SECRET_KEY=changeme_generate_a_real_secret_with_openssl_rand
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Ingestion ---
# Shared secret log shippers present via the X-API-Key header.
# Generate a real one the same way: openssl rand -hex 32
INGEST_API_KEY=changeme_generate_a_real_key_with_openssl_rand

# --- Threat intel (optional — enrichment no-ops cleanly without these) ---
# Free key: https://www.abuseipdb.com/register, then Account -> API Settings
ABUSEIPDB_API_KEY=
# Free key: https://otx.alienvault.com/ (create account), then
# Settings -> API Integration
OTX_API_KEY=

# --- CORS ---
# Comma-separated list of origins the browser is allowed to call this API
# from. Defaults to the frontend's local dev port; add your real deployed
# frontend origin here if this ever runs anywhere but localhost.
CORS_ORIGINS=http://localhost:3000

# --- SOAR (optional — auto_case_notify playbook skips the notify step
# cleanly without this, same graceful-degradation pattern as the threat
# intel keys) ---
# Any endpoint that accepts a JSON POST — e.g. a Slack incoming webhook URL,
# or https://webhook.site for testing what gets sent.
WEBHOOK_URL=
