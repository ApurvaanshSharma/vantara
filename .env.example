# Copy this file to .env and fill in real values.
# .env.example is committed to git (no secrets here).
# .env is gitignored — never commit it.

# --- Postgres ---
POSTGRES_USER=vantara
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=vantara

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200
# Must be 8+ chars with upper, lower, digit, and special char (OpenSearch demo installer enforces this)
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Vantara@Dev2026!
