# Copy this file to .env and fill in real values.
# .env.example is committed to git (no secrets here).
# .env is gitignored — never commit it.

# --- Postgres ---
POSTGRES_USER=vantara
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=vantara

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200
# Must be 8+ chars with upper, lower, digit, and special char (OpenSearch demo installer enforces this)
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Vantara@Dev2026!

# --- Backend / JWT ---
# Generate a real one with: openssl rand -hex 32
# Never reuse this placeholder value outside your own local machine.
JWT_SECRET_KEY=changeme_generate_a_real_secret_with_openssl_rand
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
